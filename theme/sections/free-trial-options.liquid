{{ 'section-free-trial-options.css' | asset_url | stylesheet_tag }}

<div class="free-trial-options color-{{ section.settings.color_scheme }} gradient page-width section-{{ section.id }}-padding">
  {%- if section.settings.heading != blank -%}
    <h1 class="free-trial-options__heading">{{ section.settings.heading | escape }}</h1>
  {%- endif -%}

  {%- if section.settings.subheading != blank -%}
    <p class="free-trial-options__subheading">{{ section.settings.subheading | escape }}</p>
  {%- endif -%}

  <div class="free-trial-options__grid">
    {%- for block in section.blocks -%}
      <article class="free-trial-options__card" {{ block.shopify_attributes }}>
        {%- if block.settings.tag != blank -%}
          <span class="free-trial-options__tag">{{ block.settings.tag | escape }}</span>
        {%- endif -%}

        <h2 class="free-trial-options__card-title">{{ block.settings.title | escape }}</h2>

        {%- if block.settings.short_copy != blank -%}
          <p class="free-trial-options__short">{{ block.settings.short_copy | escape }}</p>
        {%- endif -%}

        {%- if block.settings.details != blank -%}
          <details class="free-trial-options__details">
            <summary>View full details</summary>
            <div class="free-trial-options__details-body rte">
              {{ block.settings.details }}
            </div>
          </details>
        {%- endif -%}

        {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
          <a href="{{ block.settings.button_link }}" class="button button--primary free-trial-options__button">
            {{ block.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </article>
    {%- endfor -%}
  </div>
</div>

<style>
  .free-trial-options { padding: 4rem 0; }
  .free-trial-options__heading { text-align: center; margin: 0 0 1rem; font-size: clamp(2rem, 4vw, 3rem); }
  .free-trial-options__subheading { text-align: center; max-width: 60ch; margin: 0 auto 3rem; opacity: 0.85; }
  .free-trial-options__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    max-width: 1100px;
    margin: 0 auto;
  }
  .free-trial-options__card {
    background: rgb(var(--color-background));
    border: 1px solid rgba(var(--color-foreground), 0.15);
    border-radius: 12px;
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .free-trial-options__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.1);
  }
  .free-trial-options__tag {
    display: inline-block;
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    align-self: flex-start;
  }
  .free-trial-options__card-title { margin: 0; font-size: 1.75rem; line-height: 1.2; }
  .free-trial-options__short { margin: 0; font-size: 1rem; opacity: 0.9; }
  .free-trial-options__details { margin-top: auto; }
  .free-trial-options__details summary {
    cursor: pointer;
    font-weight: 600;
    padding: 0.5rem 0;
    list-style: none;
    user-select: none;
  }
  .free-trial-options__details summary::after { content: ' ▾'; font-size: 0.8em; }
  .free-trial-options__details[open] summary::after { content: ' ▴'; }
  .free-trial-options__details-body { padding: 0.5rem 0 1rem; font-size: 0.95rem; line-height: 1.55; }
  .free-trial-options__details-body ul { padding-left: 1.2rem; margin: 0.5rem 0; }
  .free-trial-options__button { margin-top: 0.5rem; }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
</style>

{% schema %}
{
  "name": "Free Trial Options",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Start Training with Box 2 Fit"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Choose how you'd like to begin."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "accent-1", "label": "Accent 1" },
        { "value": "accent-2", "label": "Accent 2" },
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "inverse", "label": "Inverse" }
      ],
      "default": "background-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "option",
      "name": "Option card",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Tag label",
          "default": "Option 1"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card title",
          "default": "Free Trial Waiver"
        },
        {
          "type": "text",
          "id": "short_copy",
          "label": "Short tagline",
          "default": "Try a class for free."
        },
        {
          "type": "richtext",
          "id": "details",
          "label": "Full details (expanded)",
          "default": "<p>Complete your waiver before attending your first class.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Start Free Trial"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Free Trial Options",
      "blocks": [
        {
          "type": "option",
          "settings": {
            "tag": "Option 1",
            "title": "Free Trial Waiver",
            "short_copy": "Try a class for free.",
            "details": "<p>Complete your waiver before attending your first class.</p>",
            "button_label": "Start Free Trial"
          }
        },
        {
          "type": "option",
          "settings": {
            "tag": "Option 2 — Save 15%",
            "title": "Sign Up Now & Save 15%",
            "short_copy": "Join today and receive 15% off your first month.",
            "details": "<p>Complete your membership waiver and registration online.</p><ul><li>No contract.</li><li>30-day cancellation policy after the first 30 days.</li></ul>",
            "button_label": "Sign Up & Save 15%"
          }
        }
      ]
    }
  ]
}
{% endschema %}
