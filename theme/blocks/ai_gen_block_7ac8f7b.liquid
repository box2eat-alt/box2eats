{% doc %}
  @prompt
    I want 4 divs that have an image and a box under it the box should have a mini title, header, subtitle and a button under it 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-four-column-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
  }

  .ai-four-column-grid__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.column_gap }}px;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-four-column-grid__column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-four-column-grid__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-four-column-grid__image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-four-column-grid__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-four-column-grid__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-four-column-grid__content-box-{{ ai_gen_id }} {
    background-color: {{ block.settings.box_background_color }};
    padding: {{ block.settings.box_padding }}px;
    border-radius: {{ block.settings.box_border_radius }}px;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.text_gap }}px;
  }

  .ai-four-column-grid__mini-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.mini_title_size }}px;
    color: {{ block.settings.mini_title_color }};
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0;
    font-weight: 600;
  }

  .ai-four-column-grid__header-{{ ai_gen_id }} {
    font-size: {{ block.settings.header_size }}px;
    color: {{ block.settings.header_color }};
    margin: 0;
    font-weight: 700;
    line-height: 1.2;
  }

  .ai-four-column-grid__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-four-column-grid__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    text-align: center;
    transition: background-color 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-four-column-grid__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-four-column-grid__container-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-four-column-grid__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<four-column-grid-{{ ai_gen_id }} class="ai-four-column-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-four-column-grid__container-{{ ai_gen_id }}">
    {% for i in (1..4) %}
      {% liquid
        assign image_key = 'column_' | append: i | append: '_image'
        assign mini_title_key = 'column_' | append: i | append: '_mini_title'
        assign header_key = 'column_' | append: i | append: '_header'
        assign subtitle_key = 'column_' | append: i | append: '_subtitle'
        assign button_text_key = 'column_' | append: i | append: '_button_text'
        assign button_link_key = 'column_' | append: i | append: '_button_link'

        assign column_image = block.settings[image_key]
        assign mini_title = block.settings[mini_title_key]
        assign header = block.settings[header_key]
        assign subtitle = block.settings[subtitle_key]
        assign button_text = block.settings[button_text_key]
        assign button_link = block.settings[button_link_key]
      %}

      <div class="ai-four-column-grid__column-{{ ai_gen_id }}">
        <div class="ai-four-column-grid__image-wrapper-{{ ai_gen_id }}">
          {% if column_image %}
            <img
              src="{{ column_image | image_url: width: 600 }}"
              alt="{{ column_image.alt | escape }}"
              loading="lazy"
              width="{{ column_image.width }}"
              height="{{ column_image.height }}"
            >
          {% else %}
            <div class="ai-four-column-grid__image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>

        <div class="ai-four-column-grid__content-box-{{ ai_gen_id }}">
          {% if mini_title != blank %}
            <p class="ai-four-column-grid__mini-title-{{ ai_gen_id }}">{{ mini_title }}</p>
          {% endif %}

          {% if header != blank %}
            <h3 class="ai-four-column-grid__header-{{ ai_gen_id }}">{{ header }}</h3>
          {% endif %}

          {% if subtitle != blank %}
            <p class="ai-four-column-grid__subtitle-{{ ai_gen_id }}">{{ subtitle }}</p>
          {% endif %}

          {% if button_text != blank %}
            <a
              href="{{ button_link }}"
              class="ai-four-column-grid__button-{{ ai_gen_id }}"
            >
              {{ button_text }}
            </a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</four-column-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class FourColumnGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }
    customElements.define('four-column-grid-{{ ai_gen_id }}', FourColumnGrid{{ ai_gen_id }});
  })();
</script>

