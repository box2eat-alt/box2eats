    {
      "type": "header",
      "content": "Secondary button"
    },
    {
      "type": "text",
      "id": "button_secondary_label",
      "label": "Label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "button_secondary_link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "button_secondary_bg",
      "label": "Background color",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "button_secondary_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_secondary_border",
      "label": "Border color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_secondary_hover_bg",
