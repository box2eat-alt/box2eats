      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Primary button"
    },
    {
      "type": "text",
      "id": "button_primary_label",
      "label": "Label",
      "default": "Get started"
    },
    {
      "type": "url",
      "id": "button_primary_link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "button_primary_bg",
      "label": "Background color",
      "default": "#c0272d"
    },
    {
      "type": "color",
      "id": "button_primary_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_primary_hover_bg",
