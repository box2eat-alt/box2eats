{% doc %}
  @prompt
    Create a weekly schedule section that displays a 7-day schedule with customizable time slots and activities for each day. The section should include:
    
    LAYOUT & STRUCTURE:
    - Header with title, subtitle, and description text
    - Grid layout showing all 7 days (Monday-Sunday) as individual cards
    - Each day card shows the day name, multiple time slots, and activities
    - Responsive columns that adapt for mobile and desktop
    - Optional image banner block
    
    CUSTOMIZATION SETTINGS:
    - Section anchor ID field (text input) for deep linking
    - Header: title, subtitle, description, text alignment
    - Layout: max width, padding (top/bottom), number of columns, gap spacing
    - Day card styling: padding, border width, border radius
    - Closed message: custom text for days marked as closed
    
    COLORS:
    - Background color
    - Title, subtitle, and description text colors
    - Day card background and text colors
    - Day name text color
    - Time and activity text colors
    - Border color for day cards
    
    TYPOGRAPHY:
    - Font sizes for: title, subtitle, day names, times, activities
    
    DAY-SPECIFIC SETTINGS (for each day Monday-Sunday):
    - Toggle to mark day as closed
    - Multiple time slot inputs (at least 3-4 slots per day)
    - Activity/class name for each time slot
    - If closed, display the closed message instead
    
    VISUAL STYLE:
    - Clean card-based design with subtle borders
    - Organized grid layout
    - Clear hierarchy between day names, times, and activities
    - Professional spacing and padding throughout
    
    Make sure the anchor ID setting outputs as an HTML id attribute on the main section wrapper so links like #schedule will work., I need them to have 8 activitys and 8 time slots. , I want the outlines of the boxes to be our red colour 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-schedule-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
  }

  .ai-schedule-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-schedule-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: 40px;
  }

  .ai-schedule-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0 0 8px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-schedule-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px;
    font-weight: 700;
  }

  .ai-schedule-description-{{ ai_gen_id }} {
    color: {{ block.settings.description_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-schedule-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.gap }}px;
    margin-bottom: 20px;
  }

  .ai-schedule-day-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    color: {{ block.settings.card_text_color }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-schedule-day-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.day_name_size }}px;
    font-weight: 700;
    color: {{ block.settings.day_name_color }};
    margin: 0;
    padding-bottom: 12px;
    border-bottom: 2px solid {{ block.settings.card_border_color }};
  }

  .ai-schedule-slots-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-schedule-slot-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ai-schedule-time-{{ ai_gen_id }} {
    font-size: {{ block.settings.time_size }}px;
    color: {{ block.settings.time_color }};
    font-weight: 600;
  }

  .ai-schedule-activity-{{ ai_gen_id }} {
    font-size: {{ block.settings.activity_size }}px;
    color: {{ block.settings.activity_color }};
    line-height: 1.4;
  }

  .ai-schedule-closed-{{ ai_gen_id }} {
    font-size: {{ block.settings.activity_size }}px;
    color: {{ block.settings.activity_color }};
    font-style: italic;
    opacity: 0.7;
    text-align: center;
    padding: 20px 0;
  }

  @media screen and (max-width: 989px) {
    .ai-schedule-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-schedule-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-schedule-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-schedule-subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.9);
    }
  }
{% endstyle %}

<weekly-schedule-{{ ai_gen_id }}
  class="ai-schedule-{{ ai_gen_id }}"
  {% if block.settings.anchor_id != blank %}id="{{ block.settings.anchor_id }}"{% endif %}
  {{ block.shopify_attributes }}
>
  <div class="ai-schedule-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.subtitle != blank or block.settings.description != blank %}
      <div class="ai-schedule-header-{{ ai_gen_id }}">
        {% if block.settings.subtitle != blank %}
          <p class="ai-schedule-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
        {% endif %}
        {% if block.settings.title != blank %}
          <h2 class="ai-schedule-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.description != blank %}
          <div class="ai-schedule-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-schedule-grid-{{ ai_gen_id }}">
      {% assign days = 'monday,tuesday,wednesday,thursday,friday,saturday,sunday' | split: ',' %}
      {% assign day_names = 'Monday,Tuesday,Wednesday,Thursday,Friday,Saturday,Sunday' | split: ',' %}

      {% for day in days %}
        {% assign day_closed_key = day | append: '_closed' %}
        {% assign is_closed = block.settings[day_closed_key] %}

        <div class="ai-schedule-day-{{ ai_gen_id }}">
          <h3 class="ai-schedule-day-name-{{ ai_gen_id }}">{{ day_names[forloop.index0] }}</h3>

          {% if is_closed %}
            <div class="ai-schedule-closed-{{ ai_gen_id }}">
              {{ block.settings.closed_message }}
            </div>
          {% else %}
            <div class="ai-schedule-slots-{{ ai_gen_id }}">
              {% for i in (1..8) %}
                {% assign time_key = day | append: '_time_' | append: i %}
                {% assign activity_key = day | append: '_activity_' | append: i %}
                {% assign time = block.settings[time_key] %}
                {% assign activity = block.settings[activity_key] %}

                {% if time != blank and activity != blank %}
                  <div class="ai-schedule-slot-{{ ai_gen_id }}">
                    <div class="ai-schedule-time-{{ ai_gen_id }}">{{ time }}</div>
                    <div class="ai-schedule-activity-{{ ai_gen_id }}">{{ activity }}</div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</weekly-schedule-{{ ai_gen_id }}>

<script>
  (function() {
    class WeeklySchedule{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('weekly-schedule-{{ ai_gen_id }}', WeeklySchedule{{ ai_gen_id }});
  })();
</script>

