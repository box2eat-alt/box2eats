{% doc %}
  @prompt
    1️⃣ Top of Section
    
    Background: Light neutral or black (depending on your brand section style)
    Centered layout
    
    Mini Title (small text above headline):
    Program Details
    
    Main Headline (H2):
    What You Get – 6 Week Program
    
    Short Subtext (1 sentence under headline):
    A structured progression designed to build skill, confidence, and consistency.
    
    ⸻
    
    2️⃣ Three Equal Columns (Desktop) / Stacked (Mobile)
    
    Each column should be a “card” with:
    	•	Bold small title
    	•	2–4 short lines max
    	•	Clean spacing
    	•	No long paragraphs, make it so i can add padding to the top or bottom 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-program-details-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    padding-left: 20px;
    padding-right: 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-program-details-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-program-details-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 50px;
  }

  .ai-program-details-mini-title-{{ ai_gen_id }} {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: {{ block.settings.mini_title_color }};
    margin: 0 0 12px 0;
    font-weight: 400;
  }

  .ai-program-details-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    color: {{ block.settings.headline_color }};
    margin: 0 0 16px 0;
    font-weight: 700;
    line-height: 1.2;
  }

  .ai-program-details-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_size }}px;
    color: {{ block.settings.subtext_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-program-details-cards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  .ai-program-details-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background_color }};
    padding: 30px 24px;
    border-radius: {{ block.settings.card_border_radius }}px;
    border: {{ block.settings.card_border_thickness }}px solid {{ block.settings.card_border_color }};
  }

  .ai-program-details-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.card_title_color }};
    font-weight: 700;
    margin: 0 0 16px 0;
    line-height: 1.3;
  }

  .ai-program-details-card-content-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_size }}px;
    color: {{ block.settings.card_text_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-program-details-card-content-{{ ai_gen_id }} p {
    margin: 0 0 8px 0;
  }

  .ai-program-details-card-content-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-program-details-cards-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ai-program-details-header-{{ ai_gen_id }} {
      margin-bottom: 30px;
    }

    .ai-program-details-headline-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.headline_size }}px * 0.8);
    }
  }
{% endstyle %}

<program-details-{{ ai_gen_id }} class="ai-program-details-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-program-details-container-{{ ai_gen_id }}">
    <div class="ai-program-details-header-{{ ai_gen_id }}">
      {% if block.settings.mini_title != blank %}
        <div class="ai-program-details-mini-title-{{ ai_gen_id }}">
          {{ block.settings.mini_title }}
        </div>
      {% endif %}

      {% if block.settings.headline != blank %}
        <h2 class="ai-program-details-headline-{{ ai_gen_id }}">
          {{ block.settings.headline }}
        </h2>
      {% endif %}

      {% if block.settings.subtext != blank %}
        <div class="ai-program-details-subtext-{{ ai_gen_id }}">
          {{ block.settings.subtext }}
        </div>
      {% endif %}
    </div>

    <div class="ai-program-details-cards-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% assign card_title_key = 'card_' | append: i | append: '_title' %}
        {% assign card_content_key = 'card_' | append: i | append: '_content' %}
        {% assign card_title = block.settings[card_title_key] %}
        {% assign card_content = block.settings[card_content_key] %}

        {% if card_title != blank or card_content != blank %}
          <div class="ai-program-details-card-{{ ai_gen_id }}">
            {% if card_title != blank %}
              <h3 class="ai-program-details-card-title-{{ ai_gen_id }}">
                {{ card_title }}
              </h3>
            {% endif %}

            {% if card_content != blank %}
              <div class="ai-program-details-card-content-{{ ai_gen_id }}">
                {{ card_content }}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</program-details-{{ ai_gen_id }}>

<script>
  (function() {
    class ProgramDetails{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('program-details-{{ ai_gen_id }}', ProgramDetails{{ ai_gen_id }});
  })();
</script>

