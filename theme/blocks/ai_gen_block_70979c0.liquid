{% doc %}
  @prompt
    I want to make an image banner, with a logo mini title, header, description and then two buttons, one on the left and then one on the right. , the overlay over the image is not working , the overlay over the image is still not working ! every time I do this the overlay never works , make it so I can stack the button on top of each other , make it so I can control the button width, and the image height for both desktop and mobile , make it so I can align the button in th emidel 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    display: block;
  }

  .ai-banner-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    height: {{ block.settings.desktop_height }}vh;
  }

  .ai-banner-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .ai-banner-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-banner-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-banner-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
    z-index: 3;
  }

  .ai-banner-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
    z-index: 1;
  }

  .ai-banner-content-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: {{ block.settings.text_alignment }};
    width: 90%;
    max-width: {{ block.settings.content_max_width }}px;
    z-index: 2;
  }

  .ai-banner-logo-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.logo_spacing }}px;
  }

  .ai-banner-logo-{{ ai_gen_id }} img {
    width: {{ block.settings.logo_width }}px;
    height: auto;
    {% if block.settings.text_alignment == 'center' %}
      margin: 0 auto;
    {% elsif block.settings.text_alignment == 'right' %}
      margin-left: auto;
    {% endif %}
  }

  .ai-banner-mini-title-{{ ai_gen_id }} {
    color: {{ block.settings.mini_title_color }};
    font-size: {{ block.settings.mini_title_size }}px;
    margin: 0 0 {{ block.settings.mini_title_spacing }}px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-banner-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    line-height: 1.2;
  }

  .ai-banner-description-{{ ai_gen_id }} {
    color: {{ block.settings.description_color }};
    font-size: {{ block.settings.description_size }}px;
    margin: 0 0 {{ block.settings.description_spacing }}px;
    line-height: 1.5;
  }

  .ai-banner-buttons-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.button_gap }}px;
    {% if block.settings.button_layout == 'stacked' %}
      flex-direction: column;
      {% if block.settings.button_alignment == 'center' %}
        align-items: center;
      {% elsif block.settings.button_alignment == 'right' %}
        align-items: flex-end;
      {% else %}
        align-items: flex-start;
      {% endif %}
    {% else %}
      flex-direction: row;
      {% if block.settings.button_alignment == 'center' %}
        justify-content: center;
      {% elsif block.settings.button_alignment == 'right' %}
        justify-content: flex-end;
      {% else %}
        justify-content: flex-start;
      {% endif %}
      flex-wrap: wrap;
    {% endif %}
  }

  .ai-banner-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    font-size: {{ block.settings.button_font_size }}px;
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    transition: all 0.3s ease;
    border: {{ block.settings.button_border_width }}px solid;
    {% if block.settings.button_layout == 'stacked' %}
      width: 100%;
      max-width: {{ block.settings.button_max_width_desktop }}px;
    {% else %}
      min-width: {{ block.settings.button_min_width_desktop }}px;
    {% endif %}
  }

  .ai-banner-button-left-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_left_bg }};
    color: {{ block.settings.button_left_text_color }};
    border-color: {{ block.settings.button_left_border }};
  }

  .ai-banner-button-left-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_left_hover_bg }};
    color: {{ block.settings.button_left_hover_text }};
    border-color: {{ block.settings.button_left_hover_border }};
  }

  .ai-banner-button-right-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_right_bg }};
    color: {{ block.settings.button_right_text_color }};
    border-color: {{ block.settings.button_right_border }};
  }

  .ai-banner-button-right-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_right_hover_bg }};
    color: {{ block.settings.button_right_hover_text }};
    border-color: {{ block.settings.button_right_hover_border }};
  }

  @media screen and (max-width: 749px) {
    .ai-banner-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_height }}vh;
    }

    .ai-banner-content-{{ ai_gen_id }} {
      width: 95%;
    }

    .ai-banner-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-banner-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }

    .ai-banner-buttons-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: center;
    }

    .ai-banner-button-{{ ai_gen_id }} {
      width: 100%;
      max-width: {{ block.settings.button_max_width_mobile }}px;
      min-width: auto;
    }
  }
{% endstyle %}

<div class="ai-banner-{{ ai_gen_id }} b2f-program-banner" data-b2f-program-banner="true" {{ block.shopify_attributes }}>
  <div class="ai-banner-wrapper-{{ ai_gen_id }}">
    {% if block.settings.image %}
      <img
        src="{{ block.settings.image | image_url: width: 2000 }}"
        alt="{{ block.settings.image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
        class="ai-banner-image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-banner-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-banner-empty-state-{{ ai_gen_id }}">
          Add a background image
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_overlay %}
      <div class="ai-banner-overlay-{{ ai_gen_id }}"></div>
    {% endif %}

    <div class="ai-banner-content-{{ ai_gen_id }}">
      {% if block.settings.logo %}
        <div class="ai-banner-logo-{{ ai_gen_id }}">
          <img
            src="{{ block.settings.logo | image_url: width: 400 }}"
            alt="{{ block.settings.logo.alt | escape }}"
            loading="lazy"
          >
        </div>
      {% endif %}

      {% if block.settings.mini_title != blank %}
        <div class="ai-banner-mini-title-{{ ai_gen_id }}">
          {{ block.settings.mini_title }}
        </div>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h1 class="ai-banner-heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h1>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-banner-description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}

      <div class="ai-banner-buttons-{{ ai_gen_id }}">
        {% if block.settings.button_left_label != blank %}
          <a
            href="{{ block.settings.button_left_link }}"
            class="ai-banner-button-{{ ai_gen_id }} ai-banner-button-left-{{ ai_gen_id }}"
          >
            {{ block.settings.button_left_label }}
          </a>
        {% endif %}

        {% if block.settings.button_right_label != blank %}
          <a
            href="{{ block.settings.button_right_link }}"
            class="ai-banner-button-{{ ai_gen_id }} ai-banner-button-right-{{ ai_gen_id }}"
          >
            {{ block.settings.button_right_label }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  if (window.__b2fProgramSliderInit) return;
  window.__b2fProgramSliderInit = true;

  function isMobile() { return window.matchMedia('(max-width: 749px)').matches; }

  function init() {
    if (!isMobile()) return;
    var banners = Array.prototype.slice.call(document.querySelectorAll('[data-b2f-program-banner]'));
    if (banners.length < 2) return;

    // Create wrapper
    var wrapper = document.createElement('div');
    wrapper.className = 'b2f-program-slider';
    var track = document.createElement('div');
    track.className = 'b2f-program-slider__track';
    wrapper.appendChild(track);

    // Insert the slider where the first banner is
    banners[0].parentNode.insertBefore(wrapper, banners[0]);

    // Move each banner into the slider track as its own slide
    banners.forEach(function(b) {
      b.classList.add('b2f-program-slide');
      track.appendChild(b);
    });
    var sections = banners; // for consistency with rest of code

    // Dots
    var dots = document.createElement('div');
    dots.className = 'b2f-program-slider__dots';
    sections.forEach(function(_, i) {
      var d = document.createElement('button');
      d.type = 'button';
      d.className = 'b2f-program-slider__dot' + (i === 0 ? ' is-active' : '');
      d.setAttribute('aria-label', 'Go to slide ' + (i + 1));
      d.addEventListener('click', function() { goTo(i); userInteracted(); });
      dots.appendChild(d);
    });
    wrapper.appendChild(dots);

    var current = 0;
    var autoTimer = null;
    var paused = false;

    function goTo(i) {
      current = (i + sections.length) % sections.length;
      track.scrollTo({ left: sections[current].offsetLeft, behavior: 'smooth' });
      Array.prototype.forEach.call(dots.children, function(d, idx) {
        d.classList.toggle('is-active', idx === current);
      });
    }

    function tick() {
      if (paused) return;
      goTo(current + 1);
    }

    function startAuto() {
      stopAuto();
      autoTimer = setInterval(tick, 5000);
    }
    function stopAuto() {
      if (autoTimer) clearInterval(autoTimer);
      autoTimer = null;
    }
    function userInteracted() {
      stopAuto();
      // Resume after 10s of no interaction
      setTimeout(startAuto, 10000);
    }

    track.addEventListener('pointerdown', function() { paused = true; });
    track.addEventListener('pointerup', function() { paused = false; userInteracted(); });
    track.addEventListener('scroll', function() {
      // Update active dot based on scroll position
      var idx = Math.round(track.scrollLeft / track.clientWidth);
      if (idx !== current) {
        current = Math.max(0, Math.min(sections.length - 1, idx));
        Array.prototype.forEach.call(dots.children, function(d, i) {
          d.classList.toggle('is-active', i === current);
        });
      }
    });

    document.addEventListener('visibilitychange', function() {
      if (document.hidden) stopAuto(); else startAuto();
    });

    startAuto();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

<style>
  .b2f-program-slider {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .b2f-program-slider__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .b2f-program-slider__track::-webkit-scrollbar { display: none; }
  .b2f-program-slider .b2f-program-slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }
  .b2f-program-slider__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    padding: 12px 0 18px;
    background: #000;
  }
  .b2f-program-slider__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255,255,255,0.35);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .b2f-program-slider__dot.is-active {
    background: rgb(192, 39, 45);
    transform: scale(1.25);
  }
  @media screen and (min-width: 750px) {
    /* Slider is only for mobile — if JS already wrapped on a resize, the layout still falls back gracefully */
    .b2f-program-slider__track {
      display: block;
      overflow: visible;
    }
    .b2f-program-slider__dots { display: none; }
    .b2f-program-slider .b2f-program-slide { flex: none; }
  }
</style>

