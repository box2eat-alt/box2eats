{% doc %}
  @prompt
    I want to make a section with 3 div cards, for our 3 gyms that link down to that specific spot on the page 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-gym-cards-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-gym-cards__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-gym-cards__heading-{{ ai_gen_id }} {
    text-align: center;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 40px;
  }

  .ai-gym-cards__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-gym-cards__card-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-gym-cards__card-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
  }

  .ai-gym-cards__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    overflow: hidden;
    position: relative;
  }

  .ai-gym-cards__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-gym-cards__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-gym-cards__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-gym-cards__content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
  }

  .ai-gym-cards__title-{{ ai_gen_id }} {
    color: {{ block.settings.card_title_color }};
    font-size: {{ block.settings.card_title_size }}px;
    margin: 0 0 10px;
    font-weight: 700;
  }

  .ai-gym-cards__description-{{ ai_gen_id }} {
    color: {{ block.settings.card_text_color }};
    font-size: {{ block.settings.card_text_size }}px;
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 989px) {
    .ai-gym-cards__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-gym-cards__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-gym-cards__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
      margin-bottom: 30px;
    }
  }
{% endstyle %}

<gym-cards-{{ ai_gen_id }} class="ai-gym-cards-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-gym-cards__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-gym-cards__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-gym-cards__grid-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign title_key = 'gym_' | append: i | append: '_title'
          assign description_key = 'gym_' | append: i | append: '_description'
          assign image_key = 'gym_' | append: i | append: '_image'
          assign anchor_key = 'gym_' | append: i | append: '_anchor'

          assign title = block.settings[title_key]
          assign description = block.settings[description_key]
          assign image = block.settings[image_key]
          assign anchor = block.settings[anchor_key]
        %}

        <a href="#{{ anchor }}" class="ai-gym-cards__card-{{ ai_gen_id }}">
          <div class="ai-gym-cards__image-wrapper-{{ ai_gen_id }}">
            {% if image %}
              <img
                src="{{ image | image_url: width: 800 }}"
                alt="{{ image.alt | escape }}"
                loading="lazy"
                width="{{ image.width }}"
                height="{{ image.height }}"
                class="ai-gym-cards__image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-gym-cards__image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-gym-cards__content-{{ ai_gen_id }}">
            {% if title != blank %}
              <h3 class="ai-gym-cards__title-{{ ai_gen_id }}">{{ title }}</h3>
            {% endif %}
            {% if description != blank %}
              <p class="ai-gym-cards__description-{{ ai_gen_id }}">{{ description }}</p>
            {% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</gym-cards-{{ ai_gen_id }}>

<script>
  (function() {
    class GymCards{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.cards = this.querySelectorAll('.ai-gym-cards__card-{{ ai_gen_id }}');
        this.setupSmoothScroll();
      }

      setupSmoothScroll() {
        this.cards.forEach((card) => {
          card.addEventListener('click', (e) => {
            e.preventDefault();
            const targetId = card.getAttribute('href').substring(1);
            const targetElement = document.getElementById(targetId);

            if (targetElement) {
              targetElement.scrollIntoView({
                behavior: 'smooth',
                block: 'start'
              });
            }
          });
        });
      }
    }

    customElements.define('gym-cards-{{ ai_gen_id }}', GymCards{{ ai_gen_id }});
  })();
</script>

