{% doc %}
  @prompt
    I want an image banner, with words over it and two buttons, and want to be able to control the height, give me the option to but a black box behind the text and if I can make the border radius of that black box, and make it an option for mobile and desktop , make it so I can hide the button if needed, and a black box on desktop and not mobile, or on mobile and not desktop. let me make the option to change between the two 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: block;
  }

  .ai-image-banner__wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.banner_height }}vh;
    min-height: 300px;
  }

  .ai-image-banner__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-image-banner__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-image-banner__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-image-banner__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-image-banner__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  .ai-image-banner__content-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: {{ block.settings.text_alignment }};
    width: 90%;
    max-width: {{ block.settings.content_max_width }}px;
    z-index: 2;
  }

  .ai-image-banner__text-box-{{ ai_gen_id }} {
    {% if block.settings.text_box_visibility == 'desktop' or block.settings.text_box_visibility == 'both' %}
      background-color: {{ block.settings.text_box_color }};
      padding: {{ block.settings.text_box_padding }}px;
      border-radius: {{ block.settings.text_box_border_radius_desktop }}px;
    {% endif %}
  }

  .ai-image-banner__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 16px;
    line-height: 1.2;
  }

  .ai-image-banner__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    margin: 0 0 24px;
    line-height: 1.5;
  }

  .ai-image-banner__buttons-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    {% if block.settings.text_alignment == 'center' %}
      justify-content: center;
    {% elsif block.settings.text_alignment == 'right' %}
      justify-content: flex-end;
    {% else %}
      justify-content: flex-start;
    {% endif %}
    flex-wrap: wrap;
  }

  .ai-image-banner__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 28px;
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .ai-image-banner__button--primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_primary_bg }};
    color: {{ block.settings.button_primary_color }};
    border: 2px solid {{ block.settings.button_primary_bg }};
  }

  .ai-image-banner__button--primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_primary_hover_bg }};
    border-color: {{ block.settings.button_primary_hover_bg }};
    color: {{ block.settings.button_primary_hover_color }};
  }

  .ai-image-banner__button--secondary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_secondary_bg }};
    color: {{ block.settings.button_secondary_color }};
    border: 2px solid {{ block.settings.button_secondary_border }};
  }

  .ai-image-banner__button--secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_secondary_hover_bg }};
    border-color: {{ block.settings.button_secondary_hover_border }};
    color: {{ block.settings.button_secondary_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-image-banner__wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_banner_height }}vh;
      min-height: 250px;
    }

    .ai-image-banner__text-box-{{ ai_gen_id }} {
      {% if block.settings.text_box_visibility == 'mobile' or block.settings.text_box_visibility == 'both' %}
        background-color: {{ block.settings.text_box_color }};
        padding: {{ block.settings.text_box_padding }}px;
        border-radius: {{ block.settings.text_box_border_radius_mobile }}px;
      {% else %}
        background-color: transparent;
        padding: 0;
        border-radius: 0;
      {% endif %}
    }

    .ai-image-banner__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-image-banner__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }

    .ai-image-banner__buttons-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: stretch;
    }

    .ai-image-banner__button-{{ ai_gen_id }} {
      text-align: center;
    }
  }

  @media screen and (min-width: 750px) {
    .ai-image-banner__text-box-{{ ai_gen_id }} {
      {% if block.settings.text_box_visibility == 'none' or block.settings.text_box_visibility == 'mobile' %}
        background-color: transparent;
        padding: 0;
        border-radius: 0;
      {% endif %}
    }
  }
{% endstyle %}

<div class="ai-image-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-banner__wrapper-{{ ai_gen_id }}">
    {% if block.settings.image %}
      <img
        src="{{ block.settings.image | image_url: width: 2000 }}"
        alt="{{ block.settings.image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
        class="ai-image-banner__image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-image-banner__placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-image-banner__empty-state-{{ ai_gen_id }}">
          Add an image to get started
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_overlay %}
      <div class="ai-image-banner__overlay-{{ ai_gen_id }}"></div>
    {% endif %}

    <div class="ai-image-banner__content-{{ ai_gen_id }}">
      <div class="ai-image-banner__text-box-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-image-banner__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="ai-image-banner__text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
        {% endif %}

        <div class="ai-image-banner__buttons-{{ ai_gen_id }}">
          {% if block.settings.show_button_primary and block.settings.button_primary_label != blank %}
            <a
              href="{{ block.settings.button_primary_link }}"
              class="ai-image-banner__button-{{ ai_gen_id }} ai-image-banner__button--primary-{{ ai_gen_id }}"
            >
              {{ block.settings.button_primary_label }}
            </a>
          {% endif %}

          {% if block.settings.show_button_secondary and block.settings.button_secondary_label != blank %}
            <a
              href="{{ block.settings.button_secondary_link }}"
              class="ai-image-banner__button-{{ ai_gen_id }} ai-image-banner__button--secondary-{{ ai_gen_id }}"
            >
              {{ block.settings.button_secondary_label }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image banner",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "banner_height",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Desktop height",
      "default": 70
    },
    {
      "type": "range",
      "id": "mobile_banner_height",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Mobile height",
      "default": 50
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Opacity",
      "default": 40
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Image banner"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 52
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Give customers details about the banner image or content on the template.</p>"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Text size",
      "default": 18
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 400,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "label": "Content max width",
      "default": 700
    },
    {
      "type": "header",
      "content": "Text box background"
    },
    {
      "type": "select",
      "id": "text_box_visibility",
      "label": "Show text box on",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "both",
          "label": "Both"
        }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "text_box_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "text_box_padding",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Padding",
      "default": 30
    },
    {
      "type": "range",
      "id": "text_box_border_radius_desktop",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Desktop border radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "text_box_border_radius_mobile",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Mobile border radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Primary button"
    },
    {
      "type": "checkbox",
      "id": "show_button_primary",
      "label": "Show primary button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_primary_label",
      "label": "Label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_primary_link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "button_primary_bg",
      "label": "Background",
      "default": "#c0272d"
    },
    {
      "type": "color",
      "id": "button_primary_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_primary_hover_bg",
      "label": "Hover background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_primary_hover_color",
      "label": "Hover text",
      "default": "#c0272d"
    },
    {
      "type": "header",
      "content": "Secondary button"
    },
    {
      "type": "checkbox",
      "id": "show_button_secondary",
      "label": "Show secondary button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_secondary_label",
      "label": "Label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "button_secondary_link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "button_secondary_bg",
      "label": "Background",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "button_secondary_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_secondary_border",
      "label": "Border",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_secondary_hover_bg",
      "label": "Hover background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_secondary_hover_color",
      "label": "Hover text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_secondary_hover_border",
      "label": "Hover border",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Button style"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Image banner"
    }
  ]
}
{% endschema %}
